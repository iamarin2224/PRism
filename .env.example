# Next.js Server Port (configured via package.json to 5050)
PORT=5050

# FastAPI AI Service Base URL (Server-side only)
AI_SERVICE_URL=http://localhost:8000

# GitHub App & Webhook Configuration (Server-side only)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_APP_ID=your_github_app_id
GITHUB_PRIVATE_KEY_PATH=your_github_private_key

GITHUB_OAUTH_CLIENT_ID=your_github_oauth_app_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_app_secret

# Optional: Inline PEM private key for serverless/Vercel deployment
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Database URL
DATABASE_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=your_non-pooled_db_url
