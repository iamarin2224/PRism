# OpenRouter LLM Configuration
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# AICredits / OpenAI Embeddings
AICREDITS_API_KEY=your_aicredits_api_key
AICREDITS_BASE_URL=https://api.aicredits.in/v1
EMBEDDING_MODEL=text-embedding-3-small
MID_MODEL=qwen/qwen3-coder-30b-a3b-instruct
HIGH_MODEL=deepseek/deepseek-v4.1-flash

# Neon PostgreSQL with pgvector
DATABASE_URL=postgresql://user:password@ep-sample-pooler.a-1.us-east-2.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@ep-sample.a-1.us-east-2.aws.neon.tech/neondb?sslmode=require

# GitHub API Token
GITHUB_TOKEN=your_github_personal_access_token

# CORS Allowed Origins (defaults to Next.js on port 5050)
NEXTJS_URL=http://localhost:5050
ALLOWED_ORIGINS=http://localhost:5050

# E2B sandbox api key
E2B_API_KEY=your_api_key
E2B_TEMPLATE=prism-polyglot-reviewer

# Redis & Asynchronous Job Queue Settings
REDIS_URL=redis://localhost:6379