generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

enum IndexStatus {
  NOT_INDEXED
  INDEXING
  INDEXED
  STALE
  FAILED
}

model User {
  id             String         @id @default(uuid())
  githubId       String         @unique @map("github_id")
  githubUsername String         @map("github_username")
  email          String?
  avatarUrl      String?        @map("avatar_url")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  installations  Installation[]
  accounts       Account[]
  sessions       Session[]

  @@map("users")
}

model Account {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refreshToken      String?  @map("refresh_token")
  accessToken       String?  @map("access_token")
  expiresAt         Int?     @map("expires_at")
  tokenType         String?  @map("token_type")
  scope             String?
  idToken           String?  @map("id_token")
  sessionState      String?  @map("session_state")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Installation {
  id             String       @id @default(uuid())
  installationId BigInt       @unique @map("installation_id")
  accountLogin   String       @map("account_login")
  accountType    String       @default("User") @map("account_type")
  accountAvatar  String?      @map("account_avatar")
  userId         String       @map("user_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories   Repository[]

  @@index([userId], name: "installations_user_idx")
  @@map("installations")
}

model Repository {
  id             String        @id @default(uuid())
  fullName       String        @unique @map("full_name")
  owner          String
  name           String
  defaultBranch  String        @default("main") @map("default_branch")
  installationId BigInt?       @map("installation_id")
  githubRepoId   BigInt?       @map("github_repo_id")
  isPrivate      Boolean       @default(false) @map("is_private")
  isTracked      Boolean       @default(false) @map("is_tracked")
  indexedCommit  String?       @map("indexed_commit")
  currentCommit  String?       @map("current_commit")
  indexStatus    IndexStatus   @default(NOT_INDEXED) @map("index_status")
  errorMessage   String?       @map("error_message")
  lastIndexedAt  DateTime?     @map("last_indexed_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  installation   Installation? @relation(fields: [installationId], references: [installationId], onDelete: SetNull)
  reviewRuns     ReviewRun[]

  @@index([installationId], name: "repositories_installation_idx")
  @@index([isTracked], name: "repositories_tracked_idx")
  @@map("repositories")
}


model CodeChunk {
  id         String   @id @default(uuid())
  repoName   String   @map("repo_name")
  commitSha  String   @map("commit_sha")
  filePath   String   @map("file_path")
  language   String
  startLine  Int      @map("start_line")
  endLine    Int      @map("end_line")
  symbol     String?
  content    String
  tokenCount Int      @map("token_count")
  createdAt  DateTime @default(now()) @map("created_at")

  // Vector embedding column mapped via Unsupported("vector(1536)") for pgvector
  embedding  Unsupported("vector(1536)")?

  @@index([repoName, filePath], name: "code_chunks_repo_file_idx")
  @@index([repoName, commitSha], name: "code_chunks_repo_commit_idx")
  @@map("code_chunks")
}

enum ReviewStatus {
  QUEUED
  IN_PROGRESS
  COMPLETED
  FAILED
  AWAITING_HUMAN_APPROVAL
  CANCELLED
}

enum RoutingDecision {
  POST_GITHUB
  REQUIRE_HUMAN_APPROVAL
  DISMISSED
}

enum SpecialistType {
  SECURITY
  QUALITY
  TESTS
  DOCS
  CRITIC
  SYNTHESIS
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum FindingCategory {
  SECURITY
  BUG
  PERFORMANCE
  DESIGN
  TEST_COVERAGE
  DOCUMENTATION
  COMPLIANCE
}

enum FeedbackType {
  ACCEPTED
  DISMISSED
  EDITED
}

model ReviewRun {
  id              String           @id @default(uuid())
  repositoryId    String?          @map("repository_id")
  repoName        String           @map("repo_name")
  prNumber        Int              @map("pr_number")
  commitSha       String           @map("commit_sha")
  baseSha         String           @map("base_sha")
  status          ReviewStatus     @default(QUEUED)
  routingDecision RoutingDecision? @map("routing_decision")
  totalTokensIn   Int              @default(0) @map("total_tokens_in")
  totalTokensOut  Int              @default(0) @map("total_tokens_out")
  totalCostUsd    Float            @default(0.0) @map("total_cost_usd")
  durationMs      Float?           @map("duration_ms")
  errorMessage    String?          @map("error_message")
  checkpointKey   String?          @map("checkpoint_key")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  repository      Repository?      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  findings        ReviewFinding[]
  auditEvents     AuditEvent[]

  @@index([repositoryId], name: "review_runs_repository_idx")
  @@index([repoName, prNumber], name: "review_runs_repo_pr_idx")
  @@index([status], name: "review_runs_status_idx")
  @@map("review_runs")
}


model ReviewFinding {
  id            String          @id @default(uuid())
  reviewRunId   String          @map("review_run_id")
  specialist    SpecialistType
  category      FindingCategory
  severity      FindingSeverity
  filePath      String          @map("file_path")
  startLine     Int             @map("start_line")
  endLine       Int             @map("end_line")
  title         String
  description   String
  suggestion    String?
  confidence    Float           @default(1.0)
  agreementCount Int            @default(1) @map("agreement_count")
  isVerified    Boolean         @default(false) @map("is_verified")
  humanFeedback FeedbackType?   @map("human_feedback")
  feedbackNotes String?         @map("feedback_notes")
  createdAt     DateTime        @default(now()) @map("created_at")

  reviewRun     ReviewRun       @relation(fields: [reviewRunId], references: [id], onDelete: Cascade)

  @@index([reviewRunId], name: "review_findings_run_idx")
  @@index([filePath], name: "review_findings_file_idx")
  @@map("review_findings")
}

model AuditEvent {
  id          String   @id @default(uuid())
  reviewRunId String   @map("review_run_id")
  spanId      String   @map("span_id")
  nodeName    String   @map("node_name")
  eventType   String   @map("event_type")
  payload     Json     @default("{}")
  tokensIn    Int      @default(0) @map("tokens_in")
  tokensOut   Int      @default(0) @map("tokens_out")
  costUsd     Float    @default(0.0) @map("cost_usd")
  durationMs  Float?   @map("duration_ms")
  createdAt   DateTime @default(now()) @map("created_at")

  reviewRun   ReviewRun @relation(fields: [reviewRunId], references: [id], onDelete: Cascade)

  @@index([reviewRunId], name: "audit_events_run_idx")
  @@index([nodeName], name: "audit_events_node_idx")
  @@map("audit_events")
}

model EpisodicMemory {
  id           String       @id @default(uuid())
  repoName     String       @map("repo_name")
  prNumber     Int          @map("pr_number")
  findingHash  String       @map("finding_hash")
  feedbackType FeedbackType @map("feedback_type")
  filePath     String       @map("file_path")
  title        String
  comment      String?
  createdAt    DateTime     @default(now()) @map("created_at")

  // Embedding column for semantic retrieval of past human feedback
  embedding    Unsupported("vector(1536)")?

  @@index([repoName, filePath], name: "episodic_memory_repo_file_idx")
  @@index([findingHash], name: "episodic_memory_hash_idx")
  @@map("episodic_memory")
}
