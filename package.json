{
  "name": "prism",
  "version": "0.2.0",
  "private": true,
  "description": "PRism — Agentic Pull Request Review System",
  "scripts": {
    "dev": "next dev -p 5050",
    "build": "next build",
    "start": "next start -p 5050",
    "lint": "next lint",
    "dev:all": "./dev.sh",
    "dev:ai": "cd ai && ([ -f .venv/bin/uvicorn ] && .venv/bin/uvicorn app.main:app --port 8000 --reload || uvicorn app.main:app --port 8000 --reload)",
    "dev:worker": "cd ai && ([ -f .venv/bin/arq ] && .venv/bin/arq app.queue.worker.WorkerSettings || arq app.queue.worker.WorkerSettings)",
    "test:webhook": "node scripts/test-webhook.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.103.2",
    "dotenv": "^17.4.2",
    "next": "^15.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "prisma": "^6.19.3",
    "typescript": "^5.8.2"
  }
}
